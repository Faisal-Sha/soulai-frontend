# Supabase Configuration
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# SoulPlus ConnectAID agent (FastAPI on Railway) — used by /agent testing page
VITE_SOULAI_AGENT_API_URL="https://soulai-agents-production.up.railway.app"

# Azure AI Foundry Configuration
# Option 1: Use AI Foundry Agent (Recommended - uses existing agent)
# Get your project endpoint from Azure AI Foundry portal: https://ai.azure.com/
# Format: https://<your-resource>.services.ai.azure.com/api/projects/<project-name>
# Find it in: Project Overview > Libraries > Azure AI Foundry
VITE_AZURE_AI_PROJECT_ENDPOINT="https://your-resource.services.ai.azure.com/api/projects/your-project"
VITE_AZURE_AI_AGENT_NAME="your-agent-id"

# Option 2: Use Direct Model API (Alternative - requires API key)
# Get your endpoint and key from Azure AI Foundry portal
# 1. Deploy a model (recommended: gpt-4o, gpt-4o-mini, or gpt-4.1-mini)
# 2. Get the endpoint URL and API key from the deployment details
# VITE_AZURE_AI_ENDPOINT="https://your-deployment.inference.ai.azure.com"
# VITE_AZURE_AI_KEY="your-api-key-here"
# VITE_AZURE_AI_MODEL="gpt-4o"

# Resend Configuration
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# ElevenLabs TTS
ELEVEN_LABS_API_KEY="your-elevenlabs-api-key"
ELEVEN_LABS_VOICE_ID="your-voice-id"

# Mixpanel Analytics
VITE_MIXPANEL_TOKEN="your-mixpanel-token"
MIXPANEL_API_SECRET="your-mixpanel-api-secret"
MIXPANEL_PROJECT_ID="your-mixpanel-project-id"

# Quiz Funnel Analytics (optional)
VITE_AMPLITUDE_API_KEY=""
VITE_META_PIXEL_ID="2499442087228684"
VITE_TIKTOK_PIXEL_ID=""
VITE_GA4_MEASUREMENT_ID=""
VITE_YANDEX_METRICA_ID="110342301"

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY="pk_live_your-stripe-publishable-key"
STRIPE_SECRET_KEY="sk_live_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"

# Chromium HTML→PDF (partner reading one-click download + email) — Browserless free tier
# Sign up: https://www.browserless.io/ → copy API token → set Supabase secret BROWSERLESS_API_KEY
BROWSERLESS_API_KEY="your-browserless-api-token"
# BROWSERLESS_URL="https://production-sfo.browserless.io"

# ─── Soul-AI Backend (Supabase Edge Functions) ───────────────────────────────
# Server-side Supabase keys (no VITE_ prefix — not exposed to browser)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_PROJECT_ID="your-project-ref"

# OpenAI (used by edge functions and backend scripts)
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o"
OPENAI_ASSISTANT_NAME="Soul-AI Matrix of Destiny Expert"

# Supabase service role (alias used by some scripts)
SERVICE_ROLE_KEY="your-supabase-service-role-key"
