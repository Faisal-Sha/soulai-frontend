{
    "routes": [
        {
            "route": "/assets/*",
            "headers": {
                "cache-control": "public, max-age=31536000, immutable"
            }
        },
        {
            "route": "/sw.js",
            "headers": {
                "cache-control": "no-cache, no-store, must-revalidate"
            }
        },
        {
            "route": "/workbox-*.js",
            "headers": {
                "cache-control": "no-cache, no-store, must-revalidate"
            }
        },
        {
            "route": "/manifest.webmanifest",
            "headers": {
                "content-type": "application/manifest+json",
                "cache-control": "no-cache"
            }
        },
        {
            "route": "/api-docs",
            "rewrite": "/api-docs/index.html"
        },
        {
            "route": "/openapi.yaml",
            "headers": {
                "content-type": "application/yaml"
            }
        },
        {
            "route": "/*",
            "serve": "/index.html",
            "statusCode": 200
        }
    ],
    "navigationFallback": {
        "rewrite": "/index.html",
        "exclude": [
            "/assets/*",
            "/api-docs/*",
            "/openapi.yaml",
            "/sw.js",
            "/workbox-*.js",
            "/manifest.webmanifest",
            "/*.{css,scss,js,png,gif,ico,jpg,jpeg,svg,webp,yaml,yml,webmanifest}"
        ]
    },
    "mimeTypes": {
        ".json": "application/json",
        ".webmanifest": "application/manifest+json"
    }
}
